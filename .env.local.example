NEXT_PUBLIC_API_BASE_URL=http://localhost:8080/api/v1
# Set to "true" to use built-in mock data instead of hitting the real backend.
NEXT_PUBLIC_USE_MOCK_API=false
# Phase 3 — base URLs of the separately-deployed client and team-member
# panels. Used by the admin "Login as" feature to redirect the browser with
# an impersonation token: {PANEL_URL}/?token=<token>
NEXT_PUBLIC_CLIENT_PANEL_URL=
NEXT_PUBLIC_TEAM_PANEL_URL=
